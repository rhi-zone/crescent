#!/usr/bin/env bash
# Pre-commit hook: typecheck staged Lua files in lib/.
#
# To activate (one-time, per clone):
#   git config core.hooksPath .githooks
#
# Each staged file is checked with `timeout 30 bin/cr check <file>`. We
# compare error counts between the staged blob and the HEAD blob for the
# same path and reject ONLY when the staged version has MORE errors than
# HEAD — i.e., the commit introduces new type errors. Editing a file with
# pre-existing errors without making them worse passes. New files must be
# error-free.
#
# A hang (timeout) is a soundness/termination bug — see CLAUDE.md "Always
# run typecheck under a timeout". The hook does NOT auto-fix; if a file
# regresses, fix the source and `git add` it again.
#
# Skip semantics:
#   - No staged Lua files in lib/  → silently pass.
#   - --no-verify                  → standard git behavior (we don't override).
#
# Bypass (use sparingly): `git commit --no-verify`. CLAUDE.md forbids
# --no-verify as a normal workflow — fix the issue or fix the hook.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -t staged < <(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^lib/.*\.lua$' \
    || true
)

if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

echo "pre-commit: typechecking ${#staged[@]} staged Lua file(s)..."

tmp_root="$(mktemp -d -t crescent-precommit.XXXXXX)"
trap 'rm -rf "$tmp_root"' EXIT

# Run `bin/cr check` on a file and echo "<error_count>|<exit_code>" plus
# write full output to $2. error_count is -1 on timeout or unparsable.
#
# We count errors whose diagnostic line begins with the staged file's
# path (relative or absolute), not all errors in the typecheck output.
# Rationale: `bin/cr check <file>` transitively typechecks the file's
# imports, so dependency files with pre-existing errors (e.g. env.lua's
# WalkerEnv cross-module alias issue) inflate the count for every
# importer — including newly-added files that have nothing to do with
# the dep. Counting only errors at the staged path keeps the hook
# focused on the change actually under review.
run_check() {
  local target="$1" outfile="$2" rel_path="${3:-}"
  local rc=0
  timeout 30 bin/cr check "$target" >"$outfile" 2>&1 || rc=$?
  if [ "$rc" -eq 124 ]; then
    echo "-1|124"
    return
  fi
  local errs
  if [ -n "$rel_path" ]; then
    # Strip ANSI escapes, then count diagnostics whose path component
    # matches either the absolute staged path or the relative repo path.
    errs="$(sed 's/\x1b\[[0-9;]*m//g' "$outfile" \
      | grep -cE "^($target|$rel_path):[0-9]+:[0-9]+: error:" \
      || true)"
  else
    # Fallback: total error count from the summary line.
    errs="$(grep -oE 'Checked [0-9]+ file\(s\): [0-9]+ error\(s\)' "$outfile" \
      | tail -n1 | grep -oE '[0-9]+ error' | grep -oE '[0-9]+' || true)"
  fi
  if [ -z "$errs" ]; then
    if [ "$rc" -ne 0 ]; then
      echo "-1|$rc"
    else
      echo "0|0"
    fi
    return
  fi
  echo "$errs|$rc"
}

failed=0
for f in "${staged[@]}"; do
  # Materialize staged blob preserving the relative path so diagnostics
  # reference a sensible location.
  staged_dir="$tmp_root/staged"
  head_dir="$tmp_root/head"
  staged_path="$staged_dir/$f"
  head_path="$head_dir/$f"
  mkdir -p "$(dirname "$staged_path")" "$(dirname "$head_path")"

  if ! git show ":$f" >"$staged_path" 2>/dev/null; then
    # Staged blob unreadable (e.g., deleted); skip.
    continue
  fi

  # HEAD version may not exist (new file).
  has_head=1
  if ! git show "HEAD:$f" >"$head_path" 2>/dev/null; then
    has_head=0
  fi

  staged_out="$tmp_root/staged.out"
  staged_result="$(run_check "$staged_path" "$staged_out" "$f")"
  staged_errs="${staged_result%|*}"
  staged_rc="${staged_result#*|}"

  if [ "$staged_errs" = "-1" ] && [ "$staged_rc" = "124" ]; then
    echo "pre-commit: TIMEOUT (>30s) on $f (staged) — typecheck is hanging." >&2
    echo "  This is a soundness/termination bug. See CLAUDE.md." >&2
    failed=1
    continue
  fi
  if [ "$staged_errs" = "-1" ]; then
    echo "pre-commit: typecheck on $f (staged) failed unparsably (exit $staged_rc):" >&2
    cat "$staged_out" >&2
    failed=1
    continue
  fi

  if [ "$has_head" -eq 0 ]; then
    # New file: any errors fail.
    if [ "$staged_errs" -gt 0 ]; then
      echo "pre-commit: new file $f has $staged_errs type error(s):" >&2
      cat "$staged_out" >&2
      failed=1
    fi
    continue
  fi

  head_out="$tmp_root/head.out"
  head_result="$(run_check "$head_path" "$head_out" "$f")"
  head_errs="${head_result%|*}"
  head_rc="${head_result#*|}"

  if [ "$head_errs" = "-1" ] && [ "$head_rc" = "124" ]; then
    echo "pre-commit: TIMEOUT (>30s) on $f (HEAD) — typecheck is hanging." >&2
    echo "  This is a soundness/termination bug. See CLAUDE.md." >&2
    failed=1
    continue
  fi
  if [ "$head_errs" = "-1" ]; then
    # HEAD unparsable — be conservative and treat as 0 so we don't mask
    # a real regression, but warn.
    echo "pre-commit: warning: typecheck on $f (HEAD) unparsable; treating as 0 errors." >&2
    head_errs=0
  fi

  if [ "$staged_errs" -gt "$head_errs" ]; then
    echo "pre-commit: $f introduces $((staged_errs - head_errs)) new type error(s) (HEAD: $head_errs, staged: $staged_errs):" >&2
    cat "$staged_out" >&2
    failed=1
  elif [ "$staged_errs" -gt 0 ]; then
    echo "pre-commit: $f has $staged_errs pre-existing error(s) (unchanged); allowing."
  fi
done

# ── Lint check ────────────────────────────────────────────────────────────────
# Run only on init.lua files (module_var, path_guard, assert, emmylua_annotation
# rules are init.lua-specific). Always disable missing_tests (test files are not
# present in the staged blob temp dir).
init_staged=()
for f in "${staged[@]}"; do
  [[ "$f" == lib/*/init.lua ]] && init_staged+=("$f")
done

if [ "${#init_staged[@]}" -gt 0 ]; then
  echo "pre-commit: linting ${#init_staged[@]} init.lua file(s)..."

  run_lint() {
    local target="$1" outfile="$2"
    local rc=0
    timeout 30 bin/cr lint --disable-rule=missing_tests "$target" >"$outfile" 2>&1 || rc=$?
    if [ "$rc" -eq 124 ]; then
      echo "-1|124"
      return
    fi
    local viols
    viols="$(grep -oE 'Checked [0-9]+ file\(s\): [0-9]+ violation\(s\)' "$outfile" \
      | tail -n1 | grep -oE '[0-9]+ violation' | grep -oE '[0-9]+' || true)"
    if [ -z "$viols" ]; then
      if [ "$rc" -ne 0 ]; then
        echo "-1|$rc"
      else
        echo "0|0"
      fi
      return
    fi
    echo "$viols|$rc"
  }

  for f in "${init_staged[@]}"; do
    staged_dir="$tmp_root/staged"
    head_dir="$tmp_root/head"
    staged_path="$staged_dir/$f"
    head_path="$head_dir/$f"
    mkdir -p "$(dirname "$staged_path")" "$(dirname "$head_path")"

    if ! git show ":$f" >"$staged_path" 2>/dev/null; then
      continue
    fi

    has_head=1
    if ! git show "HEAD:$f" >"$head_path" 2>/dev/null; then
      has_head=0
    fi

    lint_staged_out="$tmp_root/lint_staged.out"
    lint_staged_result="$(run_lint "$staged_path" "$lint_staged_out")"
    lint_staged_viols="${lint_staged_result%|*}"
    lint_staged_rc="${lint_staged_result#*|}"

    if [ "$lint_staged_viols" = "-1" ] && [ "$lint_staged_rc" = "124" ]; then
      echo "pre-commit: TIMEOUT (>30s) on lint $f (staged)." >&2
      failed=1
      continue
    fi
    if [ "$lint_staged_viols" = "-1" ]; then
      echo "pre-commit: lint on $f (staged) failed unparsably (exit $lint_staged_rc):" >&2
      cat "$lint_staged_out" >&2
      failed=1
      continue
    fi

    if [ "$has_head" -eq 0 ]; then
      if [ "$lint_staged_viols" -gt 0 ]; then
        echo "pre-commit: new file $f has $lint_staged_viols lint violation(s):" >&2
        cat "$lint_staged_out" >&2
        failed=1
      fi
      continue
    fi

    lint_head_out="$tmp_root/lint_head.out"
    lint_head_result="$(run_lint "$head_path" "$lint_head_out")"
    lint_head_viols="${lint_head_result%|*}"
    lint_head_rc="${lint_head_result#*|}"

    if [ "$lint_head_viols" = "-1" ] && [ "$lint_head_rc" = "124" ]; then
      echo "pre-commit: TIMEOUT (>30s) on lint $f (HEAD)." >&2
      failed=1
      continue
    fi
    if [ "$lint_head_viols" = "-1" ]; then
      echo "pre-commit: warning: lint on $f (HEAD) unparsable; treating as 0 violations." >&2
      lint_head_viols=0
    fi

    if [ "$lint_staged_viols" -gt "$lint_head_viols" ]; then
      echo "pre-commit: $f introduces $((lint_staged_viols - lint_head_viols)) new lint violation(s) (HEAD: $lint_head_viols, staged: $lint_staged_viols):" >&2
      cat "$lint_staged_out" >&2
      failed=1
    elif [ "$lint_staged_viols" -gt 0 ]; then
      echo "pre-commit: $f has $lint_staged_viols pre-existing lint violation(s) (unchanged); allowing."
    fi
  done
fi

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: rejecting commit due to NEW errors above." >&2
  echo "Fix the new errors and re-stage. Pre-existing errors are tolerated." >&2
  echo "(--no-verify exists but CLAUDE.md discourages it — fix the issue or the hook.)" >&2
  exit 1
fi

echo "pre-commit: passed (no new errors)."
exit 0

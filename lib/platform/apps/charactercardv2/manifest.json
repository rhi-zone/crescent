{
  "name": "Character Card v2",
  "version": "0.1.0",
  "meta": { "tags": ["charactercardv2", "ai", "llm", "roleplay", "chat"] },
  "default_entry": "server",
  "caps": {
    "self":          { "type": "self" },
    "conversations": { "type": "db" },
    "kv":            { "type": "kv",          "required": false },
    "time":          { "type": "time" }
  },
  "entry": {
    "server": {
      "main": "server.lua",
      "caps": {
        "server":    { "type": "http_server" },
        "llm_api":   { "type": "http_client", "required": false }
      }
    },
    "import": {
      "main": "import.lua",
      "caps": {
        "server":    { "type": "http_server" }
      }
    }
  }
}

{
  "name": "Character Card v2",
  "version": "0.1.0",
  "meta": { "type": "card-app" },
  "default_entry": "server",
  "caps": {
    "self":          { "type": "self",        "required": true },
    "conversations": { "type": "db",          "required": true },
    "kv":            { "type": "kv",          "required": false },
    "time":          { "type": "time",        "required": true }
  },
  "entry": {
    "server": {
      "main": "server.lua",
      "caps": {
        "server":    { "type": "http_server", "required": true },
        "llm_api":   { "type": "http_client", "required": false }
      }
    },
    "import": {
      "main": "import.lua",
      "caps": {
        "server":    { "type": "http_server", "required": true }
      }
    }
  }
}

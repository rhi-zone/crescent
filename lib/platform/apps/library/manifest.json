{
  "name": "Library",
  "version": "0.1.0",
  "meta": { "tags": ["launcher", "browser", "library"] },
  "default_entry": "server",
  "caps": {
    "self": { "type": "self" }
  },
  "entry": {
    "server": {
      "main": "server.lua",
      "caps": {
        "server": { "type": "http_server" },
        "index_db": { "type": "db", "required": false, "readonly": true, "path": "~/.crescent/apps/index.db" },
        "stdout": { "type": "stdout", "required": false },
        "stderr": { "type": "stderr", "required": false }
      }
    }
  }
}

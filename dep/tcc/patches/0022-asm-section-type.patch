+/* The section types GNU as spells by name after `@' or `%'. as also takes a
+   bare number there, and warns "unrecognized section type" for anything
+   else and then behaves as if no type had been given -- which is what
+   returning -1 makes the caller do. */
+static const struct {
+    const char *name;
+    int type;
+} asm_section_types[] = {
+    { "progbits",      SHT_PROGBITS },
+    { "nobits",        SHT_NOBITS },
+    { "note",          SHT_NOTE },
+    { "init_array",    SHT_INIT_ARRAY },
+    { "fini_array",    SHT_FINI_ARRAY },
+    { "preinit_array", SHT_PREINIT_ARRAY },
+};

+static int asm_section_type_by_name(const char *name)
+{
+    int i;
+
+    for (i = 0; i < (int)(sizeof(asm_section_types)
+                          / sizeof(asm_section_types[0])); i++)
+        if (!strcmp(name, asm_section_types[i].name))
+            return asm_section_types[i].type;
     return -1;
 }
 

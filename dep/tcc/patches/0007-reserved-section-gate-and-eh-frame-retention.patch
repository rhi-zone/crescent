+/* Find-or-bind-or-create gate for the sections tcc creates to fill one of its
+   own roles (.got, .eh_frame, .debug_*, ...).
+
+   Internal creators must come through here instead of calling new_section()
+   directly.  new_section() appends unconditionally, so an internal creator
+   that runs after input has already introduced a section under the same name
+   -- via an asm .section directive, or by merging an input object -- silently
+   produces a second section with that name, and the role pointer then refers
+   to only one of them.  Looking the name up first turns that collision into an
+   explicit, per-role decision.
+
+   SECTION_ROLE_SHARED: tcc's content can coexist with input content in the
+   section, because the format's records are self-delimiting and reference each
+   other by relative offset (.eh_frame's CIE/FDE chain, the dwarf sections).
+   Bind the role to the existing section and upgrade the header fields the role
+   depends on; tcc's own records are appended after whatever is already there.
+
+   SECTION_ROLE_PRIVATE: the section is a pure output of tcc's own linking
+   algorithm.  tcc has no input-section-to-output-section mapping layer, so
+   there is no meaning it could assign to input content under this name --
+   merging it would corrupt the table and duplicating it produces two
+   identically named sections.  Refuse the link instead: the diagnostic is
+   recorded with tcc_error_noabort, per this file's convention, so the caller
+   reports any further problems in the same run and then fails before writing
+   output.  The role still binds to the section afterwards, so the rest of the
+   pass stays well-defined on the way to that failure.
+
+   A section this function itself created is marked internal_role, so a later
+   call for the same role rebinds to it rather than tripping either policy. */
+ST_FUNC Section *reserved_section(TCCState *s1, const char *name,
+                                  int sh_type, int sh_flags, int role)
+{
+    Section *sec = have_section(s1, name);
+
+    if (!sec)
+        sec = new_section(s1, name, sh_type, sh_flags);
+    else if (!sec->internal_role) {
+        if (role == SECTION_ROLE_PRIVATE)
+            tcc_error_noabort("section '%s' is reserved for internal use", name);
+        /* bind: adopt the input section for this role.  sh_type is set to what
+           the role requires; flags are merged so nothing the input asked for
+           (SHF_ALLOC in particular) is dropped. */
+        sec->sh_type = sh_type;
+        sec->sh_flags |= sh_flags;
+    }
+    sec->internal_role = 1;
+    return sec;
+}

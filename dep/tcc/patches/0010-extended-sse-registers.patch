 	} else if (tok >= TOK_ASM_spl && tok <= TOK_ASM_dil) {
 	    op->type = OP_REG8 | OP_REG8_LOW;
 	    op->reg = 4 + tok - TOK_ASM_spl;
+	} else if (tok >= TOK_ASM_xmm8 && tok <= TOK_ASM_xmm15) {
+	    /* Upper SSE registers: same operand class as xmm0..xmm7, but with
+	       a register number >= 8.  asm_rex() turns that into the REX.R or
+	       REX.B bit (depending on whether the operand lands in ModRM.reg
+	       or ModRM.rm) and subtracts 8, so asm_modrm() still sees 0..7. */
+	    op->type = OP_SSE;
+	    op->reg = 8 + tok - TOK_ASM_xmm8;
         } else if ((op->reg = asm_parse_numeric_reg(tok, &op->type)) >= 0) {

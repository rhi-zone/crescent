--- a/dep/tcc/i386-tok.h
+++ b/dep/tcc/i386-tok.h
@@ -176,6 +176,21 @@
  DEF_ASM(bpl)
  DEF_ASM(sil)
  DEF_ASM(dil)
+ /* The upper eight SSE registers, which exist only on x86-64 and are
+    reached by the REX.R/X/B extension bit of the ModRM/SIB field that
+    holds them.  They deliberately do NOT live in the contiguous
+    al..db7 register block above: parse_operand() derives the operand
+    class there from (tok - TOK_ASM_al) >> 3, so appending xmm8..xmm15
+    right after xmm7 would renumber every later class (cr/tr/db).
+    They are parsed by an explicit branch instead, like spl..dil. */
+ DEF_ASM(xmm8)
+ DEF_ASM(xmm9)
+ DEF_ASM(xmm10)
+ DEF_ASM(xmm11)
+ DEF_ASM(xmm12)
+ DEF_ASM(xmm13)
+ DEF_ASM(xmm14)
+ DEF_ASM(xmm15)
 #endif
  /* generic two operands */
  DEF_BWLX(mov)

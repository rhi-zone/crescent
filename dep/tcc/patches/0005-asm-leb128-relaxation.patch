+/* ------------------------------------------------------------------ */
+/* LEB128 relaxation.
+
+   `.uleb128 L2-L1' where L1/L2 are not both defined yet cannot be encoded
+   when it is parsed: the value is unknown, so the *width* is unknown too.
+   Unlike a fixed-width field (handled by AsmFixup above) there is nothing
+   to reserve, because the number of bytes is itself what we are solving
+   for, and every byte a site occupies shifts everything after it.
+
+   Patching the emitted output afterwards is not an option.  Section
+   content is a flat buffer and offsets into it are baked, unrecoverably,
+   in several places: same-section branch displacements are written as
+   bare immediates with no relocation (i386-asm.c gen_disp32), forward
+   jump chains are threaded through the not-yet-patched displacement
+   fields themselves (x86_64-gen.c gsym_addr), and `.align' padding is a
+   function of the absolute position, so a delta is not even uniform
+   across a section.  Any of those would be corrupted silently.
+
+   So layout is re-run instead: assemble the unit, measure, and if any
+   site's width was wrong, rewind all state and assemble it again with
+   the better guess.  Widths only ever grow, which bounds the iteration
+   (a LEB128 is at most 10 bytes) and yields the same minimal fixed point
+   GNU as computes.  Passes after the first replay a captured token
+   stream rather than re-reading the source, so the preprocessor runs
+   exactly once -- re-running it would re-evaluate #include/#pragma once
+   against already-mutated state and silently change the input. */
+
+/* Number of bytes minimal LEB128 encoding of V needs. */
+static int asm_leb_width(int64_t v, int is_signed)
+{
+    unsigned char buf[16];
+    return asm_leb128_encode(buf, (uint64_t)v, is_signed);
+}
+
+/* Write V into N bytes of LEB128.  N is normally the minimal width, but
+   relaxation can over-reserve: `.align' can absorb an earlier site's
+   growth and make a difference smaller again, and widths never shrink
+   (shrinking risks oscillation).  In that case pad, which DWARF permits
+   explicitly -- continuation bit set on every byte but the last. */
+static void asm_leb_write(unsigned char *p, int n, int64_t v, int is_signed)
+{
+    unsigned char buf[16];
+    int len = asm_leb128_encode(buf, (uint64_t)v, is_signed), i;
+    if (len > n)
+        tcc_error("internal error: LEB128 width shrank during relaxation");
+    for (i = 0; i < len; i++)
+        p[i] = buf[i];
+    for (; i < n; i++)
+        p[i] = 0x80;            /* continuation, zero payload */
+    if (len < n)
+        p[n - 1] = is_signed && v < 0 ? 0x7f : 0x00;
+}
+
+/* Claim the next site slot for this pass.  Sites are encountered in the
+   same order every pass, so the index is a stable identity and the width
+   guess carries over. */
+static AsmLeb *asm_leb_site(void)
+{
+    AsmLeb *L;
+    if (asm_nb_lebs >= asm_lebs_alloc) {
+        asm_lebs_alloc = asm_lebs_alloc ? asm_lebs_alloc * 2 : 16;
+        asm_lebs = tcc_realloc(asm_lebs, asm_lebs_alloc * sizeof(AsmLeb));
+        memset(asm_lebs + asm_nb_lebs, 0,
+               (asm_lebs_alloc - asm_nb_lebs) * sizeof(AsmLeb));
+    }
+    L = &asm_lebs[asm_nb_lebs++];
+    if (L->width == 0)
+        L->width = 1;           /* start minimal, grow to the fixed point */
+    return L;
+}
+
+/* Resolve one site against the label values of the pass just finished. */
+static int64_t asm_leb_value(AsmLeb *L)
+{
+    ElfSym *e1 = NULL, *e2 = NULL;
+    int64_t v = L->addend;
+    if (L->sym1) {
+        e1 = elfsym(L->sym1);
+        if (!e1 || e1->st_shndx == SHN_UNDEF)
+            tcc_error("undefined symbol '%s' in LEB128 expression",
+                      get_tok_str(L->sym1->v, NULL));
+        v += (int64_t)e1->st_value;
+    }
+    if (L->sym2) {
+        e2 = elfsym(L->sym2);
+        if (!e2 || e2->st_shndx == SHN_UNDEF)
+            tcc_error("undefined symbol '%s' in LEB128 expression",
+                      get_tok_str(L->sym2->v, NULL));
+        v -= (int64_t)e2->st_value;
+    }
+    if (e1 && e2 && e1->st_shndx != e2->st_shndx)
+        tcc_error("invalid operation with label");
+    /* A lone symbol must be section-relative to be encodable at all: a
+       LEB128 field cannot carry a relocation. */
+    if (e1 && !e2 && e1->st_shndx == SHN_ABS)
+        ;                       /* absolute: fine */
+    else if (e1 && !e2 && !L->sym2 && e1->st_shndx != cur_text_section->sh_num
+             && L->sec->sh_num != e1->st_shndx)
+        tcc_error("LEB128 of a symbol outside the current section");
+    return v;

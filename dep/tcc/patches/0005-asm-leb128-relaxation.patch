+
+/* Returns non-zero if another pass is needed.  On convergence the final
+   encodings are written into the reserved bytes. */
+static int asm_relax_iterate(TCCState *s1)
+{
+    int i, changed = 0;
+    for (i = 0; i < asm_nb_lebs; i++) {
+        AsmLeb *L = &asm_lebs[i];
+        int need = asm_leb_width(asm_leb_value(L), L->is_signed);
+        if (need > L->width)
+            L->width = need, changed = 1;
+    }
+    if (changed)
+        return 1;
+    for (i = 0; i < asm_nb_lebs; i++) {
+        AsmLeb *L = &asm_lebs[i];
+        asm_leb_write(L->sec->data + L->offset, L->width,
+                      asm_leb_value(L), L->is_signed);
+    }
+    return 0;
+}

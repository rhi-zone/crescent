+/* The mirror of reserved_section(): input names a section that tcc has ALREADY
+   created for one of its own roles, and is about to put content into it.  The
+   creation gate cannot see this ordering -- by the time the input arrives the
+   role is bound and no creator runs again -- so the two by-name reuse sites on
+   the input side (the merge loop in tcc_load_object_file(), and the assembler's
+   .section/.pushsection directives) ask here instead.
+
+   The policy is the one the role already carries, so both orderings reach the
+   same outcome for the same section: SECTION_ROLE_PRIVATE refuses, everything
+   else proceeds.  SECTION_ROLE_SHARED is exactly the case where input content
+   and tcc's own records coexist, and SECTION_ROLE_NONE is an ordinary input
+   section that tcc claims no role in.
+
+   Returns -1 when the reuse was refused, 0 when it may proceed. */
+ST_FUNC int reserved_section_claim(TCCState *s1, Section *sec)
+{
+    if (sec->internal_role != SECTION_ROLE_PRIVATE)
+        return 0;
+    return reserved_section_conflict(s1, sec->name);
+}

+/* Resolve every deferred symbol difference.  Called once the whole
+   assembly input has been read, so all labels that are ever going to
+   be defined are defined. */
+static void asm_resolve_fixups(TCCState *s1)
+{
+    AsmFixup *f;
+    ElfSym *esym1, *esym2;
+    int64_t val;
+    unsigned char *p;
+
+    for (f = asm_fixups; f; f = f->next) {
+        esym1 = elfsym(f->sym1);
+        esym2 = elfsym(f->sym2);
+        if (!esym1 || esym1->st_shndx == SHN_UNDEF)
+            tcc_error("undefined symbol '%s' in difference expression",
+                      get_tok_str(f->sym1->v, NULL));
+        if (!esym2 || esym2->st_shndx == SHN_UNDEF)
+            tcc_error("undefined symbol '%s' in difference expression",
+                      get_tok_str(f->sym2->v, NULL));
+        if (esym1->st_shndx != esym2->st_shndx)
+            tcc_error("invalid operation with label");
+        val = (int64_t)(esym1->st_value - esym2->st_value) + f->addend;
+        /* The reserved field must be able to hold the result; GAS
+           diagnoses the same overflow. */
+        if (f->size < 8) {
+            int64_t lim = (int64_t)1 << (f->size * 8 - 1);
+            if (val < -lim || val >= (lim << 1))

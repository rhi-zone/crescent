+   fully read.  This is deliberately not a relocation: the value is a
+   link-time constant, both symbols being in one section. */
+typedef struct AsmFixup {
+    struct AsmFixup *next;
+    Section *sec;
+    unsigned long offset;
+    int size;           /* 1, 2, 4 or 8 */
+    Sym *sym1;          /* minuend */
+    Sym *sym2;          /* subtrahend */
+    int64_t addend;

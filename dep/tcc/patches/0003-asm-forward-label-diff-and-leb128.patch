+/* Encode V into BUF as (un)signed LEB128; returns the byte count.
+   Both forms are minimal-width, matching what GNU as emits. */
+static int asm_leb128_encode(unsigned char *buf, uint64_t v, int is_signed)
+{
+    int n = 0, b;
+    if (is_signed) {
+        int64_t sv = (int64_t)v;
+        for (;;) {
+            b = sv & 0x7f;
+            sv >>= 7;
+            if ((sv == 0 && !(b & 0x40)) || (sv == -1 && (b & 0x40))) {
+                buf[n++] = b;
+                break;
+            }
+            buf[n++] = b | 0x80;
+        }
+    } else {
+        do {
+            b = v & 0x7f;
+            v >>= 7;
+            buf[n++] = v ? (b | 0x80) : b;
+        } while (v);
+    }
+    return n;
+}
+
+static void asm_add_fixup(Section *sec, unsigned long offset, int size,
+                          ExprValue *pe)
+{
+    AsmFixup *f = tcc_malloc(sizeof(AsmFixup));
+    f->sec = sec;
+    f->offset = offset;
+    f->size = size;
+    f->sym1 = pe->sym;
+    f->sym2 = pe->sym2;
+    f->addend = (int64_t)pe->v;
+    f->next = asm_fixups;
+    asm_fixups = f;
+}
+
+static void asm_free_fixups(void)
+{
+    AsmFixup *f, *next;
+    for (f = asm_fixups; f; f = next) {
+        next = f->next;
+        tcc_free(f);
+    }
+    asm_fixups = NULL;
+}

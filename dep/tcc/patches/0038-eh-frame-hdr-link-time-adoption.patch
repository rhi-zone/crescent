+#if TCC_EH_FRAME
+/* Bind s1->eh_frame_section to the output .eh_frame the link produced.
+
+   tcc_eh_frame_start() sets that field, but it only ever runs while tcc is
+   COMPILING: it is the handle the code generator appends its own CIE and FDEs
+   to.  A link-only run (`tcc -c a.c` then `tcc -o exe a.o`) never compiles
+   anything, so the field stays NULL even though the merge loop has built a
+   complete output .eh_frame out of the input objects' own -- and .eh_frame_hdr
+   generation, which reads the field, then produced nothing at all.
+
+   Adopting the merged section here makes the field mean the same thing in both
+   modes: the output .eh_frame this link is emitting.  That is a widening of
+   when it is set, not a second meaning -- compiling appends into that same
+   output section, which is why the role is SECTION_ROLE_SHARED.
+
+   Adopt only; never create.  reserved_section() would create the section when
+   no input supplied one, and an empty .eh_frame in the output is content this
+   link does not have -- real ld emits neither section nor header in that case.
+   So look first, and bind through the reserved-section gate only on a hit, so
+   the role and the header fields it depends on are set by the same path the
+   compile-time creator uses and the input-side claim gate agrees with. */
+ST_FUNC void tcc_eh_frame_adopt_output(TCCState *s1)
+{
+    if (eh_frame_section)
+        return;
+    if (!have_section(s1, ".eh_frame"))
+        return;
+    eh_frame_section = reserved_section(s1, ".eh_frame", SHT_PROGBITS,
+                                        SHF_ALLOC, SECTION_ROLE_SHARED);
+}
+#endif
+
 /* return a reference to a section, and create it if it does not

+                    int m, int pp)
+{
+    int rxb = 7;     /* R, X, B as 1-bits; inverted on the way out */
+    int vvvv = 15;   /* no vvvv operand: the field must be all-ones */
+
+    if (rmi == -1)
+        tcc_error("VEX encoding requires a mod/rm operand");
+    /* The reg -= 8 fixups mirror asm_rex(): the low three bits stay behind
+       for the modrm/SIB byte asm_modrm() writes afterwards. */
+    if (regi != -1 && ops[regi].reg >= 8) {
+        rxb &= ~4;
+        ops[regi].reg -= 8;
+    }
+    if ((ops[rmi].type & (OP_REG | OP_MMX | OP_SSE | OP_EA))
+        && ops[rmi].reg >= 8) {
+        rxb &= ~1;
+        ops[rmi].reg -= 8;
+    }
+    if ((ops[rmi].type & OP_EA) && ops[rmi].reg2 >= 8) {
+        rxb &= ~2;
+        ops[rmi].reg2 -= 8;
+    }

+       whole -- there is no high bit to split off. */
+    if (vvvvi != -1)
+        vvvv = 15 - ops[vvvvi].reg;
+    g(0xc4);
+    g((rxb << 5) | m);
+    g((width64 ? 0x80 : 0) | (vvvv << 3) | pp);
+}

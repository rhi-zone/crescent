+    case TOK_ASMDIR_octa:
+        /* 16 bytes per operand, little-endian, and NOT `size = 16; goto
+           asm_data'.  The operand cannot go through `asm_expr': ExprValue
+           holds one uint64_t, so a 128-bit literal has nowhere to land.
+
+           Widening ExprValue would not buy agreement with GNU as either.
+           as does not sign-extend a 64-bit expression result into the upper
+           half; it propagates its own X_extrabit flag, which is why (all
+           measured against binutils 2.44) `.octa 2-1' emits 1 with every
+           bit of the upper half set, `.octa 1==1' emits all ones, and
+           `.octa 0xffffffffffffffff' zero-extends while `.octa 0-1'
+           sign-extends the same 64-bit value.  Matching that byte for byte
+           means reimplementing an as bug as a specification, and the only
+           alternative -- a hand-built 128-bit arithmetic subsystem, long
+           division included, since tcc has no __int128 -- would still
+           disagree with as wherever that flag fires.
+
+           So the grammar accepted here is what as documents for .octa,
+           "zero or more bignums", plus the one unary operator that is
+           unambiguous on a literal.  Every other operand form as accepts --
+           arithmetic, symbols (which as itself refuses to relocate at this
+           width: "cannot do unsigned 16 byte relocation"), character
+           constants, chained unary operators -- is rejected with a
+           diagnostic rather than assembled into bytes that would disagree
+           with as.  Both real users in the tree, libressl's
+           sha1_amd64_shani.S and sha256_amd64_shani.S, are bare hex
+           literals.
+
+           as is also not a fixed reference here.  Within one release (2.44)
+           it is not even self-consistent between bases: it emits zero for
+           2^64 written in octal and the right value for the same number
+           written in hex.  0036-tests pins tcc's bytes for the forms where
+           as answers from that flag or from that lexer band, and only
+           reports what the local as did. */
+        next();
+        for(n = 0;; n++) {
+            uint64_t lo, hi;
+
+            /* as documents zero or more operands, and `.octa' alone emits
+               nothing rather than being an error.  Only the first operand
+               may be absent: after a comma there has to be one, which is
+               the `.octa 1,' case (as warns there and assumes a zero). */
+            if (n == 0
+                && (tok == TOK_LINEFEED || tok == ';' || tok == CH_EOF))
+                break;

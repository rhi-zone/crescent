+                /* 0024's rule, and the same message as as: a NOBITS section
+                   has a size and no bytes, so a non-zero value has nowhere
+                   to live.  No symbol case to test for -- the operand is
+                   always a literal here. */
+                if (lo != 0 || hi != 0)
+                    tcc_error_noabort(
+                        "attempt to store non-zero value in section `%s'",
+                        sec->name);
+                ind += 16;
+            }
+            if (tok != ',')
+                break;
+            next();
+        }
+        break;
     case TOK_ASMDIR_byte:

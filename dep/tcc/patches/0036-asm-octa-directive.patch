+/* Parse one PPNUM spelling as a 128-bit unsigned integer, low half into
+   *plo and high half into *phi.  Returns 0, or 1 if the literal did not fit
+   and was truncated to 128 bits, or -1 if it is not an integer literal at
+   all -- which is what a local label reference (`1f', `2b') and a stray
+   suffix both come through as, since the lexer hands those over as one
+   PPNUM exactly like a number.
+
+   This exists because there is nowhere in tcc to put a 128-bit value:
+   `ExprValue' is a single uint64_t and every arithmetic path in this file
+   is 64-bit.  The four 32-bit limbs are the whole of the arithmetic needed
+   for `.octa' -- a multiply-accumulate per digit -- which is why they are
+   local to this function rather than a wider integer type threaded through
+   the expression evaluator.  See the comment on TOK_ASMDIR_octa for why
+   that evaluator is deliberately not widened. */
+static int asm_parse_u128(const char *p, uint64_t *plo, uint64_t *phi)
+{
+    uint32_t w[4] = { 0, 0, 0, 0 };
+    unsigned int base = 10, digits = 0;
+    int truncated = 0;
+
+    if (p[0] == '0') {
+        if (p[1] == 'x' || p[1] == 'X')
+            base = 16, p += 2;
+        else if (p[1] == 'b' || p[1] == 'B')
+            base = 2, p += 2;
+        else
+            /* Plain `0' is octal with the leading zero as its first digit,
+               so that a bare "0" is a well-formed literal and not an empty
+               digit string. */
+            base = 8, p += 1, digits = 1;
+    }
+    for (; *p != '\0'; p++) {
+        unsigned int d, k;
+        uint64_t carry;
+
+        if (*p >= '0' && *p <= '9')
+            d = *p - '0';
+        else if (*p >= 'a' && *p <= 'f')
+            d = *p - 'a' + 10;
+        else if (*p >= 'A' && *p <= 'F')
+            d = *p - 'A' + 10;
+        else
+            return -1;
+        if (d >= base)
+            return -1;
+        carry = d;
+        for (k = 0; k < 4; k++) {
+            uint64_t t = (uint64_t)w[k] * base + carry;
+            w[k] = (uint32_t)t;
+            carry = t >> 32;
+        }
+        /* as truncates rather than refusing, with a warning; the caller
+           issues it. */
+        if (carry != 0)
+            truncated = 1;
+        digits++;
+    }
+    if (digits == 0)
+        return -1;
+    *plo = (uint64_t)w[0] | ((uint64_t)w[1] << 32);
+    *phi = (uint64_t)w[2] | ((uint64_t)w[3] << 32);
+    return truncated;
+}
+
+/* Parse one `.octa' operand: an integer literal, optionally preceded by a
+   single unary `+', `-' or `~', evaluated in 128 bits. */
+static void asm_octa_operand(uint64_t *plo, uint64_t *phi)
+{
+    int op = 0, truncated;
+
+    if (tok == '+' || tok == '-' || tok == '~') {
+        op = tok;
+        next();
+    }
+    if (tok != TOK_PPNUM)
+        tcc_error(".octa takes an integer literal");
+    truncated = asm_parse_u128(tokc.str.data, plo, phi);
+    if (truncated < 0)
+        tcc_error("invalid number syntax");
+    if (truncated)
+        /* Same wording as as, which truncates and carries on. */
+        tcc_warning("bignum truncated to 16 bytes");
+    next();
+    if (op == '-' || op == '~') {
+        *plo = ~*plo, *phi = ~*phi;
+        if (op == '-' && ++(*plo) == 0)
+            ++(*phi);
+    }
+}

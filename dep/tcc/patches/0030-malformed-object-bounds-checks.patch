+/* Check, once and up front, every section-header field that the object
+   loader will later index or dereference.  Doing it here rather than at each
+   use is what keeps the loader below readable: after this returns 0, sh_name
+   indexes a NUL-terminated string inside .shstrtab, sh_link and (for
+   relocation sections) sh_info are section numbers that exist, and every
+   section that has bytes in the file has all of them in the file.
+
+   Reports the first violation and returns -1; returns 0 when the table is
+   sound.  `strsec_size' is the size of the already-loaded .shstrtab, whose
+   final byte the caller has checked is a NUL. */
+static int validate_shdr_table(TCCState *s1, ElfW(Ehdr) *ehdr,
+                               ElfW(Shdr) *shdr, unsigned long strsec_size,
+                               unsigned long file_offset, unsigned long fsize)
+{
+    ElfW(Shdr) *sh;
+    int i;
+
+    for (i = 0; i < ehdr->e_shnum; i++) {
+        sh = &shdr[i];
+        if (sh->sh_name >= strsec_size)
+            return tcc_error_noabort("invalid section name offset");
+        if (sh->sh_link >= (unsigned)ehdr->e_shnum)
+            return tcc_error_noabort("invalid section header index");
+        if (sh->sh_type == SHT_RELX
+            && sh->sh_info >= (unsigned)ehdr->e_shnum)
+            return tcc_error_noabort("invalid section header index");
+        /* ELF requires sh_addralign to be 0 or a power of two.  A value that
+           is neither reaches section_add(), which rounds the section's
+           offset up to it, and section_realloc(), which then reallocs and
+           zeroes to match -- so garbage here turns into an allocation of
+           terabytes rather than into an error.  A fuzzed object with
+           sh_addralign = 0xffff00000008 on .data.ro hung the link with no
+           output and no end.  (A power of two can still be absurdly large;
+           that residual is in TODO.md, since the bound on it is a policy
+           call and not something ELF states.) */
+        if (sh->sh_addralign & (sh->sh_addralign - 1))
+            return tcc_error_noabort("invalid section alignment");
+        /* SHT_NOBITS occupies no file space, so its sh_offset says nothing
+           and sh_size is free to exceed the file; SHT_NULL has neither. */
+        if (sh->sh_type != SHT_NOBITS && sh->sh_type != SHT_NULL) {
+            if (!range_in_file(file_offset, sh->sh_offset, sh->sh_size,
+                               fsize))
+                return tcc_error_noabort("unexpected end of file");
+        }
+    }
+    return 0;
+}

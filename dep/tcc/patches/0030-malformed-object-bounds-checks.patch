+/* Does the byte range [file_offset + off, file_offset + off + size) lie
+   inside a file of `fsize' bytes?  The sum is never formed, so that a
+   crafted sh_offset cannot wrap around and land back inside the file on a
+   host where unsigned long is 32 bits. */
+static int range_in_file(unsigned long file_offset, unsigned long off,
+                         unsigned long size, unsigned long fsize)
+{
+    if (file_offset > fsize)
+        return 0;
+    fsize -= file_offset;
+    if (off > fsize)
+        return 0;
+    return size <= fsize - off;
+}
+
+/* load_data() for input that is not trusted to be well formed.
+
+   load_data() malloc()s `size' bytes and does a short read into them when the
+   file is smaller than the header claims, leaving the tail uninitialised and
+   every field the caller reads out of it undefined -- which is how a
+   truncated object file used to walk out of the parser as a wild pointer
+   rather than as a diagnostic.  Here the range is checked against `fsize'
+   (the size of the whole file) first, and a range that does not fit returns
+   NULL for the caller to report.
+
+   The bound is the end of the FILE, not the end of an archive member, so an
+   object read out of a .a is checked slightly loosely: a malformed member can
+   still read bytes belonging to the member after it.  That is bounded memory
+   that was read from disk either way -- not an out-of-bounds access -- and
+   tightening it would mean threading the member size in through
+   tcc_load_object_file()'s signature, which the archive loader does not
+   currently have a reason to know precisely. */
+static void *load_data_bounded(int fd, unsigned long file_offset,
+                               unsigned long off, unsigned long size,
+                               unsigned long fsize)
+{
+    if (!range_in_file(file_offset, off, size, fsize))
+        return NULL;
+    return load_data(fd, file_offset + off, size);
+}
+
+/* Size of the file behind `fd', restoring nothing: every caller here seeks
+   explicitly before it reads. `long`, not `off_t`: every other lseek() call
+   in this file (see load_data() above and read_ar_header() below) already
+   treats the offset as `long`, and unlike them `off_t` is never declared
+   under _WIN32 here -- tcc.h's Windows branch pulls in <io.h> for the
+   POSIX-named lseek()/open()/close() shims but never <sys/types.h>, so
+   `off_t` is an undeclared identifier there (MSVC: C2065). `long` matches
+   both the file's own convention and what _lseek() actually returns. */
+static unsigned long file_size(int fd)
+{
+    long end = lseek(fd, 0, SEEK_END);
+    return end < 0 ? 0 : (unsigned long)end;
+}
